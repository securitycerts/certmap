{
  "name": "security-certification-roadmap",
  "version": "0.4.0",
  "description": "A static, open-source roadmap of cybersecurity certifications.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "node scripts/build-pages.mjs",
    "validate": "node scripts/validate.mjs",
    "security": "python3 scripts/security_check.py",
    "links": "node scripts/check-links.mjs",
    "og": "node scripts/build-og.mjs",
    "vendor": "cp node_modules/animejs/dist/bundles/anime.esm.min.js assets/vendor/anime.esm.min.js && cp node_modules/animejs/LICENSE.md assets/vendor/anime.LICENSE.md"
  },
  "devDependencies": {
    "animejs": "^4.5.0",
    "playwright": "^1.60.0"
  }
}
